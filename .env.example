# ==============================================================================
# EventHub Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secret (Use a strong, random 32+ character string in production)
JWT_SECRET=replace_with_secure_secret

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/eventhub?retryWrites=true&w=majority&appName=Cluster0

# Optional: Set to false to disable local JSON storage fallback and require active MongoDB Atlas
ALLOW_LOCAL_FALLBACK=true

# Cloudinary Media Storage (Required for event banners & attendee avatars)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Service (Nodemailer - for invitations and ticket confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=your_email@gmail.com

# Frontend Application Base URL (Used for generating invitation links)
APP_BASE_URL=http://localhost:5173

# Google Maps API Key (Vite client-side - for interactive event venue directions)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
